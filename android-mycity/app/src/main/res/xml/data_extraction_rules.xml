<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12 and later. See backup_rules.xml:
  the sign-in tokens are excluded from both cloud backup and phone-to-phone transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mycity_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mycity_auth.xml" />
    </device-transfer>
</data-extraction-rules>
